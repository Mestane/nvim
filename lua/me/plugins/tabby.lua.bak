return {
	"nanozuki/tabby.nvim",
	event = "VimEnter",

	dependencies = {
		"nvim-tree/nvim-web-devicons",
	},

	config = function()
		vim.opt.showtabline = 2

		local function is_duplicated(tabid, wins)
			local bufs = {}
			for _, w in ipairs(wins) do
				bufs[#bufs + 1] = vim.api.nvim_win_get_buf(w)
			end
			-- diğer tüm tablara bak
			for _, other_tab in ipairs(vim.api.nvim_list_tabpages()) do
				if other_tab ~= tabid then
					for _, w in ipairs(vim.api.nvim_tabpage_list_wins(other_tab)) do
						local other_buf = vim.api.nvim_win_get_buf(w)
						for _, buf in ipairs(bufs) do
							if buf == other_buf then
								return true
							end
						end
					end
				end
			end
			return false
		end

		local colors = {
			bg = "#131317",
			bg_sel = "#1e1e2e",
			fg = "#cdd6f4",
			fg1 = "#a1a6b7",
			fg_dim = "#26262d",
			fg_dim2 = "#313244",
			mauve = "#cba6f7",
			red = "#f38ba8",
			yellow = "#f9e2af",
			blue = "#89b4fa",
			-- blue = "#C2C1FF",
			green = "#a6e3a1",
			last = "#C2C1FF",
			catp = "#F5B2E0",
			-- dup = "#f2cdcd",
			dup = "#ba5370",
			memory = "#b4befe",
			black = "#000000",
		}

		local theme = {
			fill = { bg = colors.bg, fg = colors.fg },
			head = { fg = colors.blue, bg = colors.bg },
			-- current_tab = { fg = colors.bg, bg = colors.blue, style = "underlineline" },
			current_tab = { fg = colors.bg, bg = colors.blue, style = "bold" },
			tab = { fg = "#7f849c", bg = colors.fg_dim, style = "italic" },
			win = { fg = colors.fg, bg = colors.bg },
			tail = { fg = colors.blue, bg = colors.bg },
			custom = { bg = colors.bg, fg = colors.red },
			custom3 = { bg = colors.last, fg = colors.bg },
			custom2 = { bg = colors.red, fg = colors.bg, style = "bold" },
			custom4 = { bg = colors.catp, fg = colors.bg, style = "bold" },
			custom5 = { fg = colors.fg, bg = colors.fg_dim2, style = "italic" },
			gitcolor = { fg = "#131317", bg = colors.green, style = "bold" },
			memcolor = { fg = colors.bg, bg = colors.memory, style = "italic" },
			pathcolor = { fg = colors.bg, bg = colors.mauve, style = "bold" },
		}

		local mem_cache = { value = "", last_time = 0 }

		local function get_memory()
			local now = os.time()
			if now - mem_cache.last_time < 7 then -- 7 seconds
				return mem_cache.value
			end
			local file = io.open("/proc/meminfo", "r")
			if not file then
				return ""
			end
			local total, available
			for line in file:lines() do
				local key, val = line:match("(%w+):%s+(%d+)")
				if key == "MemTotal" then
					total = tonumber(val)
				end
				if key == "MemAvailable" then
					available = tonumber(val)
				end
				if total and available then
					break
				end
			end
			file:close()
			if not total or not available then
				return ""
			end

			local used_gb = string.format("%.1f", (total - available) / 1024 / 1024)
			mem_cache.value = "󰍛 " .. used_gb .. "GB"
			-- local used_mb = math.floor((total - available) / 1024)
			-- mem_cache.value = "󰍛 " .. used_mb .. "MB"
			mem_cache.last_time = now
			return mem_cache.value
		end
		-----------------------------------------------------------------------------------

		-- local function get_git_hunks()
		-- 	if not vim.b.gitsigns_head then
		-- 		return {}
		-- 	end
		-- 	local signs = vim.b.gitsigns_status_dict
		-- 	if not signs then
		-- 		return {}
		-- 	end
		-- 	local added = signs.added or 0
		-- 	local changed = signs.changed or 0
		-- 	local removed = signs.removed or 0
		-- 	if added == 0 and changed == 0 and removed == 0 then
		-- 		return {}
		-- 	end
		-- 	return {
		-- 		added > 0 and { "+" .. added, hl = { fg = colors.bg, bg = theme.gitcolor.bg } } or "",
		-- 		changed > 0 and { "~" .. changed, hl = { fg = colors.bg, bg = theme.gitcolor.bg } } or "",
		-- 		removed > 0 and { "-" .. removed, hl = { fg = colors.bg, bg = theme.gitcolor.bg } } or "",
		-- 	}
		-- end

		require("tabby").setup({
			line = function(line)
				-- local hunks = get_git_hunks()
				return {
					{
						{ "  ", hl = theme.custom4 },
						line.sep("", theme.custom4, theme.fill),
					},
					{
						line.sep("", theme.memcolor, theme.fill),
						{ " " .. get_memory() .. " ", hl = theme.memcolor },
						line.sep("", theme.memcolor, theme.fill),
					},

					{
						line.sep("", theme.pathcolor, theme.fill),
						{ " 󰣞 " .. vim.fn.fnamemodify(vim.fn.getcwd(), ":t") .. " ", hl = theme.pathcolor },
						line.sep("", theme.pathcolor, theme.fill),
					},

                    line.truncate_point(),

					-- #hunks > 0 and {
					-- 	line.sep("", theme.gitcolor, theme.fill),
					-- 	{ " 󰊢 ", hl = theme.gitcolor },
					-- 	hunks,
					-- 	{ " ", hl = theme.gitcolor },
					-- 	line.sep("", theme.gitcolor, theme.fill),
					-- } or "",

					line.spacer(),
					line.tabs().foreach(function(tab)
						local hl = tab.is_current() and theme.current_tab or theme.tab
						local wins = vim.api.nvim_tabpage_list_wins(tab.id)

						local modified = false
						for _, w in ipairs(wins) do
							if vim.bo[vim.api.nvim_win_get_buf(w)].modified then
								modified = true
								break
							end
						end

						local duplicated = is_duplicated(tab.id, wins)

						-- local name = tab.name()
						-- local clean_name = name:gsub("^%[(.-)%]$", "%1") -- [Floating] -> Floating
						-- local first_char = clean_name:sub(1, 1):upper()
						-- local display_name = clean_name:sub(1, 1):upper() .. clean_name:sub(2)

						return {
							line.sep("", hl, theme.fill),
							tab.jump_key(), -- "1", "2", "3" ... gösterir
							tab.current_win().file_icon(),
							-- {tab.current_win().file_icon(), hl = { fg = tab.is_current() and colors.blue or colors.fg1, bg = hl.bg },},
							-- first_char .. " " .. display_name,
							-- first_char .. "",
							-- tab.number(),
							tab.name(),
							-- tab_display_name(tab),
							-- {
							-- 	tab.name(),
							-- 	hl = {
							-- 		fg = modified and colors.black or (tab.is_current() and colors.bg or colors.fg1),
							-- 		bg = hl.bg,
							-- 		style = tab.is_current() and "bold" or nil,
							-- 	},
							-- },
							modified and {
								"",
								-- hl = { fg = tab.is_current() and colors.bg or colors.blue, bg = hl.bg },
								hl = { fg = tab.is_current() and colors.bg or colors.blue, bg = hl.bg },
							} or "",
							duplicated and { "󰆑", hl = { fg = colors.dup, bg = hl.bg } } or "",
							-- tab.close_btn(""),
							line.sep("", hl, theme.fill),
							hl = hl,
							margin = " ",
						}
					end),
					line.spacer(),

					line.wins_in_tab(line.api.get_current_tab()).foreach(function(win)
						local win_hl = win.is_current() and theme.custom2 or theme.custom5
						local buf = vim.api.nvim_win_get_buf(win.id)
						local ft = vim.bo[buf].filetype
						-- vim.notify("ft: " .. ft, vim.log.levels.INFO)


						local hidden_filetypes_buf = {
							Avante = true,
							AvanteInput = true,
							AvanteSelectedFiles = true,
							snacks_layout_box = true,
						}
						if hidden_filetypes_buf[ft] then
							return ""
						end

						return {
							{
								line.sep("", win_hl, theme.fill),
								win.file_icon(),
								win.buf_name(),
								line.sep("", win_hl, theme.fill),
								hl = win_hl,
								margin = " ",
							},
						}
					end),

					-- line.wins_in_tab(line.api.get_current_tab()).foreach(function(win)
					-- 	local win_hl = win.is_current() and theme.custom2 or theme.custom5
					--
					-- 	return {
					-- 		{
					-- 			line.sep("", win_hl, theme.fill),
					-- 			win.file_icon(),
					-- 			win.buf_name(),
					-- 			line.sep("", win_hl, theme.fill),
					-- 			hl = win_hl,
					-- 			margin = " ",
					-- 		},
					-- 	}
					-- end),

					-- {
					-- 	line.sep("", theme.memcolor, theme.fill),
					-- 	{ " " .. get_memory() .. " ", hl = theme.memcolor },
					-- 	line.sep("", theme.memcolor, theme.fill),
					-- },
					{
						line.sep("", theme.custom3, theme.fill),
						{ "  ", hl = theme.custom3 },
						-- { "  ", hl = theme.custom3 },
					},
					hl = theme.fill,
				}
			end,

			-- option = {
			-- 	tab_name = {
			-- 		name_fallback = function(tabid)
			-- 			return tabid
			-- 		end,
			-- 	},
			-- 	buf_name = {
			-- 		mode = "tail", -- or 'relative', 'tail', 'shorten'
			-- 	},
			-- },
		})
		vim.keymap.set("n", "<leader>tj", "<Cmd>Tabby jump_to_tab<CR>", { desc = "Jump to tab" })

		vim.keymap.set("n", "<leader>tr", function()
			local name = vim.fn.input("Tab name (empty to reset): ")
			vim.cmd("Tabby rename_tab " .. name)
		end, { desc = "Rename tab" })
	end,
}
